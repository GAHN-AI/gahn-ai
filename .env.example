# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin access
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI teaching engine
# Add the real value in Vercel Environment Variables and local .env.local.
# Never commit a real secret key to GitHub.
OPENAI_API_KEY=
OPENAI_TEACHING_MODEL=gpt-5.6-luna

# Cost safeguards for the Free Plan.
EARLY_ACCESS_AI_TURNS_PER_DAY=40
EARLY_ACCESS_FILE_ANALYSES_PER_DAY=5

# Comma-separated founder/admin emails allowed to view /admin/early-access.
GAHN_ADMIN_EMAILS=

# Stripe stays disabled during Free Plan testing until paid plans are ready.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LEARNER_PLUS_PRICE_ID=
STRIPE_MASTERY_PRICE_ID=
STRIPE_CAREER_PRO_PRICE_ID=
STRIPE_CLASSROOM_AI_PRICE_ID=
STRIPE_SCHOOL_OS_PRICE_ID=

# Optional product services already used by the repository.
# PostHog browser analytics (public project token, not a private API key).
# Set both for the production deployment; keep previews separate if desired.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
# Legacy local development token name is still accepted if already in use:
# NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_AUTH_TOKEN=
RESEND_API_KEY=
FEEDBACK_NOTIFICATION_EMAIL=support@gahnai.com
